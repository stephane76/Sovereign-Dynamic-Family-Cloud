# Copy to .env on VPS, never commit .env
DOMAIN=YourFamily.eu
ACME_EMAIL=admin@YourFamily.eu
PUBLIC_IP=REPLACE_WITH_PUBLIC_IPV4
# Exact directory URL from the Actalis customer portal (do not guess)
ACME_CA_SERVER=https://REPLACE_WITH_ACTALIS_ACME_DIRECTORY
# EAB credentials from Actalis; never commit actual values
ACME_EAB_KID=REPLACE_WITH_ACTALIS_KID
ACME_EAB_HMAC=REPLACE_WITH_ACTALIS_HMAC_BASE64URL
